   <music>
      <body>
         <mdiv>
            <score>
               <scoreDef meter.count="4" meter.unit="8">
                  <staffGrp><staffDef n="1" lines="5" clef.shape="G" clef.line="2"/></staffGrp>
               </scoreDef>
               <section>
                  <measure n="1">
                     <staff n="1">
                        <layer n="1">
                           <note pname="c" oct="4" dur="8"/>
                           <note xml:id="solo-start" pname="d" oct="4" dur="8"/>
                           <note pname="e" oct="4" dur="8"/>
                           <note xml:id="solo-end" pname="f" oct="4" dur="8"/>
                        </layer>
                     </staff>
                     <dir startid="#solo-start" endid="#solo-end" extender="true" lform="dotted" place="below">solo</dir>
                     <dir staff="1" tstamp="3" tstamp2="1m+2.5" extender="true" place="above">sul pont.</dir>
