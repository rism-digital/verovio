<?xml version="1.0" encoding="UTF-8"?>
<mei xmlns="http://www.music-encoding.org/ns/mei" meiversion="5.1">
   <meiHead>
      <fileDesc>
         <titleStmt><title>Clef changes</title></titleStmt>
         <pubStmt/>
      </fileDesc>
   </meiHead>
   <music>
      <body>
         <mdiv>
            <score>
               <scoreDef meter.count="2" meter.unit="4">
                  <staffGrp>
                     <staffGrp bar.thru="true">
                        <grpSym symbol="brace"/>
                        <label>Piano</label>
                        <instrDef xml:id="piano"/>
                        <staffDef n="1" lines="5" clef.shape="G" clef.line="2" clef.dis="8" clef.dis.place="below"/>
                        <staffDef n="2" lines="5" clef.shape="F" clef.line="4"/>
                     </staffGrp>
                  </staffGrp>
               </scoreDef>
               <section>
                  <measure n="1">
                     <staff n="1">
                        <layer n="1">
                           <beam>
                              <note pname="c" oct="3" dur="8"/>
                              <note pname="d" oct="3" dur="8"/>
                              <clef xml:id="alto-change" shape="C" line="3"/>
                              <note pname="e" oct="4" dur="8"/>
                              <note pname="f" oct="4" dur="8"/>
                           </beam>
                        </layer>
                        <layer n="2"><note pname="a" oct="3" dur="2"/></layer>
                     </staff>
                     <staff n="2">
                        <layer n="3">
                           <note pname="c" oct="3" dur="4"/>
                           <clef xml:id="tenor-change" shape="C" line="4"/>
                           <note pname="d" oct="3" dur="4"/>
                        </layer>
                     </staff>
                  </measure>
                  <measure n="2">
                     <staff n="1">
                        <layer n="1">
                           <clef xml:id="after-barline" shape="G" line="2" dis="8" dis.place="above"/>
                           <note pname="g" oct="5" dur="2"/>
                           <clef xml:id="trailing-clef" shape="F" line="4"/>
                        </layer>
                        <layer n="2"><mRest/></layer>
                     </staff>
                     <staff n="2">
                        <layer n="3"><note pname="e" oct="3" dur="2"/></layer>
                     </staff>
                  </measure>
               </section>
            </score>
         </mdiv>
      </body>
   </music>
</mei>
