<?xml version="1.0" encoding="UTF-8"?>
<mei xmlns="http://www.music-encoding.org/ns/mei" meiversion="5.1">
   <meiHead>
      <fileDesc>
         <titleStmt><title>Multi-measure rests</title></titleStmt>
         <pubStmt/>
      </fileDesc>
   </meiHead>
   <music>
      <body>
         <mdiv>
            <score>
               <scoreDef meter.count="3" meter.unit="8" keysig="1f">
                  <staffGrp>
                     <staffDef n="1" lines="5" clef.shape="G" clef.line="2"/>
                     <staffGrp bar.thru="true">
                        <grpSym symbol="brace"/>
                        <instrDef xml:id="piano"/>
                        <staffDef n="2" lines="5" clef.shape="G" clef.line="2"/>
                        <staffDef n="3" lines="5" clef.shape="F" clef.line="4"/>
                     </staffGrp>
                  </staffGrp>
               </scoreDef>
               <section>
                  <measure n="1" left="rptstart" right="dbl">
                     <staff n="1">
                        <layer n="1"><multiRest num="3" block="true"/></layer>
                     </staff>
                     <staff n="2">
                        <layer n="1"><multiRest num="3" block="true"/></layer>
                     </staff>
                     <staff n="3">
                        <layer n="1"><mSpace/></layer>
                     </staff>
                     <tempo staff="1" tstamp="1" place="above" midi.bpm="90">Andante</tempo>
                  </measure>
                  <scoreDef meter.count="2" meter.unit="4" keysig="1s"/>
                  <measure right="rptend">
                     <staff n="1">
                        <layer n="1"><multiRest num="2" block="false"/></layer>
                     </staff>
                     <staff n="2">
                        <layer n="1"><multiRest num="2" block="false"/></layer>
                     </staff>
                     <staff n="3">
                        <layer n="1"><mSpace/></layer>
                     </staff>
                  </measure>
                  <measure>
                     <staff n="1">
                        <layer n="1"><note pname="g" oct="4" dur="2"/></layer>
                     </staff>
                     <staff n="2">
                        <layer n="1"><note pname="e" oct="4" dur="2"/></layer>
                     </staff>
                     <staff n="3">
                        <layer n="1"><note pname="c" oct="3" dur="2"/></layer>
                     </staff>
                  </measure>
               </section>
            </score>
         </mdiv>
      </body>
   </music>
</mei>
