<?xml version="1.0" encoding="UTF-8"?>
<mei xmlns="http://www.music-encoding.org/ns/mei" meiversion="5.1">
   <meiHead>
      <fileDesc>
         <titleStmt><title>Triplet and beamed quintuplet</title></titleStmt>
         <pubStmt/>
      </fileDesc>
   </meiHead>
   <music>
      <body>
         <mdiv>
            <score>
               <scoreDef meter.count="4" meter.unit="4">
                  <staffGrp><staffDef n="1" lines="5" clef.shape="G" clef.line="2"/></staffGrp>
               </scoreDef>
               <section>
                  <measure n="1">
                     <staff n="1">
                        <layer n="1">
                           <tuplet num="3" numbase="2" num.format="ratio" num.place="above"
                              bracket.place="above" bracket.visible="true">
                              <note xml:id="triplet-start" pname="c" oct="4" dur="8" dots="1"/>
                              <rest dur="16"/>
                              <chord xml:id="triplet-end" dur="8">
                                 <note pname="e" oct="4"/>
                                 <note pname="g" oct="4"/>
                              </chord>
                           </tuplet>
                           <note xml:id="after-triplet" pname="c" oct="5" dur="2" dots="1"/>
                        </layer>
                     </staff>
                     <dynam startid="#after-triplet" place="below">f</dynam>
                     <slur startid="#triplet-start" endid="#triplet-end" curvedir="above"/>
                  </measure>
                  <measure n="2">
                     <staff n="1">
                        <layer n="1">
                           <beam>
                              <tuplet num="5" numbase="4" num.visible="false" bracket.visible="false">
                                 <note pname="g" oct="4" dur="8"/>
                                 <note pname="a" oct="4" dur="8"/>
                                 <note pname="b" oct="4" dur="8"/>
                                 <note pname="c" oct="5" dur="8"/>
                                 <note pname="d" oct="5" dur="8"/>
                              </tuplet>
                           </beam>
                           <note pname="e" oct="5" dur="2"/>
                        </layer>
                     </staff>
                  </measure>
               </section>
            </score>
         </mdiv>
      </body>
   </music>
</mei>
