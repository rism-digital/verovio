<?xml version="1.0" encoding="UTF-8"?>
<mei xmlns="http://www.music-encoding.org/ns/mei" meiversion="5.1">
   <meiHead>
      <fileDesc>
         <titleStmt><title>Fermatas, caesuras and breath marks</title></titleStmt>
         <pubStmt/>
      </fileDesc>
   </meiHead>
   <music>
      <body>
         <mdiv>
            <score>
               <scoreDef meter.count="4" meter.unit="8">
                  <staffGrp>
                     <instrDef xml:id="piano"/>
                     <staffDef n="1" lines="5" clef.shape="G" clef.line="2"/>
                     <staffDef n="2" lines="5" clef.shape="F" clef.line="4"/>
                  </staffGrp>
               </scoreDef>
               <section>
                  <measure n="1">
                     <staff n="1">
                        <layer n="1">
                           <chord xml:id="opening-chord" dur="8">
                              <note pname="c" oct="5"/>
                              <note pname="e" oct="5"/>
                           </chord>
                           <rest dur="8"/>
                           <note xml:id="first-g" pname="g" oct="4" dur="8"/>
                           <note xml:id="last-g" pname="g" oct="4" dur="8"/>
                        </layer>
                        <layer n="2">
                           <note pname="b" oct="4" dur="2"/>
                        </layer>
                     </staff>
                     <staff n="2">
                        <layer n="1"><mRest/></layer>
                     </staff>
                     <fermata staff="1" tstamp="0"/>
                     <fermata startid="#opening-chord" shape="angular" color="#aabbcc"/>
                     <fermata staff="1" tstamp="2" place="below" form="inv" shape="square"/>
                     <fermata staff="2" tstamp="1"/>
                     <fermata staff="1" tstamp="5"/>
                     <caesura staff="1" tstamp="3" place="above"/>
                     <breath startid="#first-g" place="above"/>
                     <caesura startid="#first-g" place="below"/>
                     <breath staff="1" tstamp="4.5" place="below"/>
                     <slur startid="#opening-chord" endid="#first-g"/>
                     <tie startid="#first-g" endid="#last-g"/>
                  </measure>
               </section>
            </score>
         </mdiv>
      </body>
   </music>
</mei>
