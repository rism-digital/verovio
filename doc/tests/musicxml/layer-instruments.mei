<?xml version="1.0" encoding="UTF-8"?>
<mei xmlns="http://www.music-encoding.org/ns/mei" meiversion="5.1">
   <meiHead>
      <fileDesc>
         <titleStmt><title>Layer instruments</title></titleStmt>
         <pubStmt/>
      </fileDesc>
   </meiHead>
   <music>
      <body>
         <mdiv xml:id="movement">
            <score>
               <scoreDef meter.count="2" meter.unit="4">
                  <staffGrp>
                     <staffDef n="1" lines="5" clef.shape="G" clef.line="2">
                        <layerDef n="1">
                           <instrDef xml:id="oboe" label="Oboe"/>
                        </layerDef>
                        <layerDef n="2">
                           <instrDef xml:id="clarinet" label="Clarinet"/>
                        </layerDef>
                     </staffDef>
                  </staffGrp>
               </scoreDef>
               <section>
                  <measure n="0" metcon="false">
                     <staff n="1">
                        <layer n="1"><note pname="g" oct="4" dur="4"/></layer>
                        <layer n="2"><note pname="e" oct="4" dur="4"/></layer>
                     </staff>
                  </measure>
               </section>
            </score>
         </mdiv>
      </body>
   </music>
</mei>
