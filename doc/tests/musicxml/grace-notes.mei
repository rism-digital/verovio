<?xml version="1.0" encoding="UTF-8"?>
<mei xmlns="http://www.music-encoding.org/ns/mei" meiversion="5.1">
   <meiHead>
      <fileDesc>
         <titleStmt><title>Grace notes and grace groups</title></titleStmt>
         <pubStmt/>
      </fileDesc>
   </meiHead>
   <music>
      <body>
         <mdiv>
            <score>
               <scoreDef meter.count="2" meter.unit="4">
                  <staffGrp><staffDef n="1" lines="5" clef.shape="G" clef.line="2"/></staffGrp>
               </scoreDef>
               <section>
                  <measure n="1">
                     <staff n="1">
                        <layer n="1">
                           <note xml:id="grace-start" pname="d" oct="4" dur="8" grace="unacc" stem.dir="up"/>
                           <chord dur="16" grace="acc">
                              <note pname="e" oct="4"/>
                              <note pname="g" oct="4"/>
                           </chord>
                           <beam>
                              <note xml:id="first-rhythmic" pname="c" oct="4" dur="8"/>
                              <note pname="e" oct="4" dur="8"/>
                              <graceGrp grace="acc">
                                 <beam>
                                    <note pname="f" oct="4" dur="16"/>
                                    <note pname="g" oct="4" dur="16"/>
                                 </beam>
                              </graceGrp>
                              <note pname="a" oct="4" dur="8"/>
                              <note pname="b" oct="4" dur="16" grace="unacc"/>
                              <note pname="c" oct="5" dur="8"/>
                           </beam>
                        </layer>
                        <layer n="2"><note pname="f" oct="3" dur="2"/></layer>
                     </staff>
                     <slur startid="#grace-start" endid="#first-rhythmic" curvedir="above"/>
                     <fermata staff="1" tstamp="1" place="above"/>
                  </measure>
                  <measure n="2">
                     <staff n="1">
                        <layer n="1">
                           <graceGrp>
                              <beam>
                                 <note pname="e" oct="4" dur="32"/>
                                 <note pname="f" oct="4" dur="32"/>
                              </beam>
                           </graceGrp>
                        </layer>
                        <layer n="2"><note pname="g" oct="3" dur="2"/></layer>
                     </staff>
                  </measure>
               </section>
            </score>
         </mdiv>
      </body>
   </music>
</mei>
