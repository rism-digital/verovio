<?xml version="1.0" encoding="UTF-8"?>
<mei xmlns="http://www.music-encoding.org/ns/mei" meiversion="5.1">
   <meiHead>
      <fileDesc>
         <titleStmt><title>Staff instrument and voices</title></titleStmt>
         <pubStmt/>
      </fileDesc>
   </meiHead>
   <music>
      <body>
         <mdiv xml:id="movement">
            <score>
               <scoreDef meter.count="4" meter.unit="4" keysig="1s">
                  <staffGrp>
                     <staffDef n="1" lines="5" clef.shape="G" clef.line="2">
                        <label>Violin</label>
                        <instrDef xml:id="violin"/>
                     </staffDef>
                  </staffGrp>
               </scoreDef>
               <section>
                  <measure n="1">
                     <staff n="1">
                        <layer n="1">
                           <chord dur="4" dots="1">
                              <note pname="f" oct="4" accid.ges="s"/>
                              <note pname="a" oct="4"/>
                           </chord>
                           <note pname="f" oct="4" dur="8" accid="n"/>
                           <rest dur="2"/>
                        </layer>
                        <layer n="2">
                           <space dur="2"/>
                           <note pname="c" oct="4" dur="4"/>
                        </layer>
                     </staff>
                  </measure>
                  <measure n="2">
                     <staff n="1">
                        <layer n="1"><mRest/></layer>
                     </staff>
                  </measure>
               </section>
            </score>
         </mdiv>
      </body>
   </music>
</mei>
