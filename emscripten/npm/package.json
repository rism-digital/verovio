{
  "name": "verovio",
  "version": "6.4.0-alpha",
  "description": "This is the stable version of the verovio package",
  "main": "dist/verovio-toolkit-wasm.js",
  "types": "dist/types/index.d.ts",
  "exports": {
    ".": {
      "default": "./dist/verovio-toolkit-wasm.js",
      "types": "./dist/types/index.d.ts"
    },
    "./esm": {
      "import": "./dist/verovio.mjs",
      "require": "./dist/verovio.cjs",
      "types": "./dist/types/esm/index.d.mts"
    },
    "./wasm": {
      "import": "./dist/verovio-module.mjs",
      "default": "./dist/verovio-module.mjs",
      "types": "./dist/types/wasm/index.d.mts"
    },
    "./wasm-hum": {
      "import": "./dist/verovio-module-hum.mjs",
      "default": "./dist/verovio-module-hum.mjs",
      "types": "./dist/types/wasm-hum/index.d.mts"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "rollup --config",
    "postbuild": "rm -rf ./dist/types && cp -r ./src/types ./dist",
    "prebundle": "rollup --config rollup.config.prebundle.mjs"
  },
  "keywords": [
    "music",
    "music notation",
    "music engraving",
    "mei",
    "music encoding",
    "svg"
  ],
  "author": "Laurent Pugin and others",
  "license": "LGPL-3.0-or-later",
  "repository": {
    "type": "git",
    "url": "https://github.com/rism-digital/verovio.git"
  },
  "bugs": {
    "url": "https://github.com/rism-digital/verovio/issues"
  },
  "homepage": "https://www.verovio.org",
  "engines": {
    "node": ">= 14.18.0"
  },
  "devDependencies": {
    "@rollup/plugin-commonjs": "^24.1.0",
    "rollup": "^3.20.6"
  }
}
